# Copy to .env.local and fill in the values

# Resend – sending contact form emails (https://resend.com)
RESEND_API_KEY=
FROM_EMAIL=
TO_EMAIL=

# Upstash Redis – rate limiting (https://upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sanity – content (https://sanity.io). Not secret: the dataset is public and read-only.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
